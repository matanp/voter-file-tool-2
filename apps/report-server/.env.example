# Copy to .env and fill in real values. No secrets in this file.
# See docs/LOCAL_DEVELOPMENT.md for full local dev setup.

# Server
PORT=8080
CALLBACK_URL=http://localhost:3000/api/reportComplete
# Generate a cryptographically secure secret (min 32 bytes / 64 hex chars): openssl rand -hex 32 or Node: crypto.randomBytes(32).toString('hex'). Must match the service that validates incoming webhooks.
WEBHOOK_SECRET=

# BOE eligibility re-scan schedule (Ticket 4.6)
# Enabled by default. Set to false/0/off/no to disable.
BOE_FLAGGING_RESCAN_ENABLED=true
# Recurring interval in hours (default 24 for daily cadence).
BOE_FLAGGING_RESCAN_INTERVAL_HOURS=24
# Delay after server start before first scheduled run.
BOE_FLAGGING_RESCAN_INITIAL_DELAY_MINUTES=10
# Optional: force recurring scans to a specific term id.
BOE_FLAGGING_RESCAN_TERM_ID=

# R2 / S3-compatible storage (use a dev bucket; same vars as frontend)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Database (same as frontend: local Docker or remote URL)
POSTGRES_PRISMA_URL=postgresql://user:password@localhost:5432/your_database

NODE_ENV=development
