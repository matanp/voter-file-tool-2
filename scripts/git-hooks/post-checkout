#!/bin/sh
# Install: cp scripts/git-hooks/post-checkout .git/hooks/ (git shares hooks across all worktrees).
# $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout.

[ "$3" = "1" ] || exit 0

top=$(git rev-parse --show-toplevel)
main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

# New worktree: previous HEAD is all zeros.
if [ "$1" = "0000000000000000000000000000000000000000" ]; then
  [ -x "$top/scripts/link-scratch.sh" ] && "$top/scripts/link-scratch.sh"
  exit 0
fi

# Main checkout switched to a branch that still tracks .scratch: git may have overwritten the
# live tracker with that branch's copy.
if [ "$top" = "$main" ] && [ -n "$(git ls-tree -d HEAD .scratch)" ]; then
  echo "" >&2
  echo "WARNING: this branch still tracks .scratch, so git may have overwritten the live tracker." >&2
  echo "Switch back to a branch without .scratch, then check: git -C .scratch status" >&2
  echo "Restore with: git -C .scratch checkout -- . (uncommitted tracker edits may be lost)" >&2
  echo "" >&2
fi
exit 0
