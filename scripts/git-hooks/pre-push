#!/bin/sh
# Install: cp scripts/git-hooks/pre-push .git/hooks/ (git shares hooks across all worktrees).
# When you push this repo to origin, also push the issue tracker repo (.scratch in the main checkout) if it has
# unpushed commits. It never fails the code push, and it gives up after a few seconds without prompting for
# credentials. Git runs pre-push for `git push --dry-run` too, so a dry run also pushes the tracker.
# TRACKER_PUSH_DRY=1 prints what it would do instead. See docs/agents/issue-tracker.md.
# $1 = remote name, $2 = remote URL; stdin = "<local ref> <local sha> <remote ref> <remote sha>" per ref.

# Only for pushes to origin, and only when something is being sent (not just branch deletions).
[ "$1" = "origin" ] || exit 0
zero=0000000000000000000000000000000000000000
sending=0
while read -r _ lsha _ _; do [ "$lsha" != "$zero" ] && sending=1; done
[ "$sending" = 1 ] || exit 0

common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
[ -n "$common" ] || exit 0
live="$(dirname "$common")/.scratch"
[ -d "$live/.git" ] || exit 0

# Git sets repo-local variables (GIT_DIR, GIT_CONFIG_PARAMETERS, …) for hooks. Clear them so the git calls
# below act on the tracker repo and don't inherit this push's options.
unset $(git rev-parse --local-env-vars)

ahead=$(git -C "$live" rev-list --count '@{u}..HEAD' 2>/dev/null) || {
  echo "tracker: can't compare with its upstream (detached HEAD or no upstream); not pushed" >&2; exit 0; }
[ "$ahead" -gt 0 ] || exit 0

if [ -n "${TRACKER_PUSH_DRY:-}" ]; then
  echo "tracker: would push $ahead commit(s) from $live" >&2
  exit 0
fi

if out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=10' \
    git -C "$live" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 push -q </dev/null 2>&1); then
  echo "tracker: pushed $ahead commit(s)" >&2
else
  echo "tracker: push failed, run: git -C .scratch push" >&2
  printf '%s\n' "$out" | sed 's/^/tracker:   /' >&2
fi
exit 0
